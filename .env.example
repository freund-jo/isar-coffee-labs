# Isar Coffee Labs – credentials
# setup_labs.py fills this in for you. You only need to edit it by hand if you want to.
# Use ONE of the two options below.

# Option A: your own Anthropic API key (from console.anthropic.com)
ANTHROPIC_API_KEY=

# Option B: a company AI gateway that speaks the Anthropic Messages API
# LABS_GATEWAY_URL=https://your-gateway.example.com
# Either a fixed key ...
# LABS_GATEWAY_KEY=
# ... or a command that prints a fresh key (for SSO-based gateways)
# LABS_GATEWAY_KEY_COMMAND=
# Extra headers, separated by ";"   e.g.  x-team-id: 1234
# LABS_GATEWAY_HEADERS=
# Text in front of the model names, e.g. bedrock.anthropic.
# LABS_MODEL_PREFIX=

# Set to "system" by setup_labs.py if your network needs the system certificate store
# LABS_TLS=
